# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data: downloaded and generated files are reproducible from the scripts,
# so only the folder placeholders are tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model files
outputs/models/*
!outputs/models/.gitkeep

# Generated predictions
outputs/predictions/*
!outputs/predictions/.gitkeep

# Excel lock files
~$*.xlsx
